{
    "version": 5,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "${sourceDir}/out/bin/${presetName}",
            "toolchainFile": "${sourceDir}/CMake/Toolchain.cmake",
            "generator": "Ninja",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "environment": {
                "PATH": "${sourceDir}/out/build/${presetName}/Source/Editor${pathListSep}$penv{PATH}"
            },
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "POLOS_INSTALL_DIR": "${sourceDir}/out/bin/${presetName}"
            }
        },
        {
            "name": "linux-base",
            "inherits": "base",
            "environment": {
                "VCPKG_ROOT": "$env{HOME}/vcpkg",
                "VULKAN_SDK": "$env{HOME}/VulkanSDK/1.4.363.0/x86_64",
                "PATH": "${sourceDir}/out/build/${presetName}/Source/Editor${pathListSep}$env{VULKAN_SDK}/bin${pathListSep}$penv{PATH}",
                "LD_LIBRARY_PATH": "$env{VULKAN_SDK}/lib/VulkanLoader/lib${pathListSep}$penv{LD_LIBRARY_PATH}",
                "VK_ADD_LAYER_PATH": "$env{VULKAN_SDK}/share/vulkan/explicit_layer.d${pathListSep}$penv{VK_ADD_LAYER_PATH}"
            },
            "cacheVariables": {
                "Vulkan_INCLUDE_DIR": "$env{VULKAN_SDK}/include",
                "Vulkan_LIBRARY": "$env{VULKAN_SDK}/lib/VulkanLoader/lib/libvulkan.so",
                "GLSLANG_EXECUTABLE": "$env{VULKAN_SDK}/bin/glslang"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "win-debug",
            "displayName": "x64-Debug",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "linux-debug",
            "displayName": "x64-Debug",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "win-release",
            "displayName": "x64-Release",
            "inherits": "win-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "linux-release",
            "displayName": "x64-Release",
            "inherits": "linux-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "win-relwithdebinfo",
            "displayName": "x64-RelWithDebInfo",
            "inherits": "win-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "linux-relwithdebinfo",
            "displayName": "x64-RelWithDebInfo",
            "inherits": "linux-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "base",
            "configurePreset": "base",
            "targets": [
                "install"
            ],
            "hidden": true,
            "verbose": false
        },
        {
            "name": "win-debug",
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "displayName": "x64-Debug",
            "configurePreset": "win-debug"
        },
        {
            "name": "win-release",
            "inherits": "win-debug",
            "displayName": "x64-Release",
            "configurePreset": "win-release"
        },
        {
            "name": "linux-debug",
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "displayName": "x64-Debug",
            "configurePreset": "linux-debug"
        },
        {
            "name": "linux-release",
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "displayName": "x64-Release",
            "configurePreset": "linux-release"
        }
    ],
    "testPresets": [
        {
            "name": "PolosTest",
            "description": "",
            "displayName": "polos-test-release",
            "configurePreset": "win-release"
        }
    ]
}
