{
    "version": 5,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "${sourceDir}/out/bin/${presetName}",
            "toolchainFile": "${sourceDir}/CMake/Toolchain.cmake",
            "generator": "Ninja",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "environment": {
                "PATH": "$penv{PATH}"
            },
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "POLOS_INSTALL_DIR": "${sourceDir}/out/bin/${presetName}"
            }
        },
        {
            "name": "release-sdk",
            "displayName": "Release SDK",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BUILD_EXAMPLES": "OFF"
            }
        },
        {
            "name": "release-runtime",
            "displayName": "Release Runtime",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "debug-sdk",
            "displayName": "Debug SDK",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BUILD_EXAMPLES": "OFF"
            }
        },
        {
            "name": "debug-runtime",
            "displayName": "Debug Runtime",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "linux-base",
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "win-debug",
            "displayName": "x64-Debug",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "linux-debug",
            "displayName": "x64-Debug",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "win-release",
            "displayName": "x64-Release",
            "inherits": "win-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "linux-release",
            "displayName": "x64-Release",
            "inherits": "linux-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "win-relwithdebinfo",
            "displayName": "x64-RelWithDebInfo",
            "inherits": "win-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "linux-relwithdebinfo",
            "displayName": "x64-RelWithDebInfo",
            "inherits": "linux-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "base",
            "configurePreset": "base",
            "targets": [
                "install"
            ],
            "hidden": true,
            "verbose": false
        },
        {
            "name": "release-sdk",
            "displayName": "Release SDK",
            "inherits": "base",
            "configurePreset": "release-sdk",
            "targets": [
                "install-sdk"
            ]
        },
        {
            "name": "release-runtime",
            "displayName": "Release Runtime",
            "inherits": "base",
            "configurePreset": "release-runtime",
            "targets": [
                "install-runtime"
            ]
        },
        {
            "name": "debug-sdk",
            "displayName": "Debug SDK",
            "inherits": "base",
            "configurePreset": "debug-sdk",
            "targets": [
                "install-sdk"
            ]
        },
        {
            "name": "debug-runtime",
            "displayName": "Debug Runtime",
            "inherits": "base",
            "configurePreset": "debug-runtime",
            "targets": [
                "install-runtime"
            ]
        },
        {
            "name": "win-debug",
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "displayName": "x64-Debug",
            "configurePreset": "win-debug"
        },
        {
            "name": "win-release",
            "inherits": "win-debug",
            "displayName": "x64-Release",
            "configurePreset": "win-release"
        },
        {
            "name": "linux-debug",
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "displayName": "x64-Debug",
            "configurePreset": "linux-debug"
        },
        {
            "name": "linux-release",
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "displayName": "x64-Release",
            "configurePreset": "linux-release"
        },
        {
            "name": "win-relwithdebinfo",
            "inherits": "win-debug",
            "displayName": "x64-RelWithDebInfo",
            "configurePreset": "win-relwithdebinfo"
        },
        {
            "name": "linux-relwithdebinfo",
            "inherits": "linux-debug",
            "displayName": "x64-RelWithDebInfo",
            "configurePreset": "linux-relwithdebinfo"
        }
    ],
    "testPresets": [
        {
            "name": "PolosTest",
            "description": "",
            "displayName": "polos-test-release",
            "configurePreset": "win-release"
        }
    ]
}