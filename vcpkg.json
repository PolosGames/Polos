{
    "name": "polos",
    "version-string": "0.0.1",
    "dependencies": [
        {
            "name": "tinygltf",
            "version>=": "3.0.0#2"
        },
        "ctre",
        {
            "name": "glfw3",
            "platform": "linux",
            "version>=": "3.5.1#0",
            "features": [
                "wayland"
            ]
        },
        "glfw3",
        "glm",
        "gtest",
        {
            "name": "imgui",
            "features": [
                "docking-experimental",
                "glfw-binding",
                "vulkan-binding"
            ]
        },
        {
            "name": "quill",
            "version>=": "9.0.0#0"
        },
        "vulkan-memory-allocator"
