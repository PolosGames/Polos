cmake_minimum_required(VERSION 3.25)

# Usage: cmake [-DPART=major|minor|patch] -P Scripts/bump_version.cmake
get_filename_component(POLOS_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if (NOT DEFINED PART)
    set(PART patch)
endif()
if (NOT PART MATCHES "^(major|minor|patch)$")
    message(FATAL_ERROR "PART must be major, minor, or patch")
endif()
file(READ "${POLOS_ROOT}/VERSION" CURRENT_VERSION)
string(STRIP "${CURRENT_VERSION}" CURRENT_VERSION)
if (NOT CURRENT_VERSION MATCHES "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$")
    message(FATAL_ERROR "Invalid VERSION: ${CURRENT_VERSION}")
endif()
set(MAJOR "${CMAKE_MATCH_1}")
set(MINOR "${CMAKE_MATCH_2}")
set(PATCH "${CMAKE_MATCH_3}")
if (PART STREQUAL "major")
    math(EXPR MAJOR "${MAJOR} + 1")
    set(MINOR 0)
    set(PATCH 0)
elseif (PART STREQUAL "minor")
    math(EXPR MINOR "${MINOR} + 1")
    set(PATCH 0)
else()
    math(EXPR PATCH "${PATCH} + 1")
endif()
set(NEXT_VERSION "${MAJOR}.${MINOR}.${PATCH}")
# Keep vcpkg's project metadata in sync; builds always read VERSION.
file(READ "${POLOS_ROOT}/vcpkg.json" MANIFEST)
string(REGEX REPLACE "\"version-string\": \"[^\"]+\"" "\"version-string\": \"${NEXT_VERSION}\"" MANIFEST "${MANIFEST}")
file(WRITE "${POLOS_ROOT}/vcpkg.json" "${MANIFEST}")
file(WRITE "${POLOS_ROOT}/VERSION" "${NEXT_VERSION}\n")
message(STATUS "Polos ${CURRENT_VERSION} -> ${NEXT_VERSION}")
